# ─────────────────────────────────────────────────────────────────────
# NAGRIVANTA — environment variables (copy to .env, never commit secrets)
# ─────────────────────────────────────────────────────────────────────

# ── Frontend (build-time — GitHub Pages) ────────────────────────────
# Set as a GitHub repository variable named VITE_API_URL
# (repo Settings → Secrets and variables → Actions → Variables) so the
# Pages deploy workflow bakes the deployed backend origin into the bundle.
# The app silently falls back to the built-in demo provider when the
# API is unreachable, so an unset value still yields a working demo.
VITE_API_URL=https://nagrivanta-api.onrender.com

# ── Backend (Render / Heroku / local) ───────────────────────────────
# SQLAlchemy connection string. Render injects it from the attached
# Postgres (see render.yaml). Local default when unset:
#   sqlite:///./nagrivanta.db
# NOTE: Render's filesystem is ephemeral — without Postgres the demo
# data re-seeds on every redeploy.
DATABASE_URL=

# Origins allowed to call the API (comma-separated). Must include the
# GitHub Pages origin. Do NOT use "*" — credentials are allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gauravwakle96.github.io

# Demo mode keeps the seeded synthetic dataset and demo role auth on.
DEMO_MODE=true

# Demo role-session defaults (no real identity provider wired yet —
# mutating routes still enforce server-side role checks).
DEFAULT_ROLE=CITY_ADMIN
DEFAULT_USER_ID=u-admin-1

# Provider switches — boundaries exist, external integrations are NOT
# faked (Phase 3). "demo" = local synthetic behaviour.
NOTIFICATION_PROVIDER=demo
AI_PROVIDER=demo
